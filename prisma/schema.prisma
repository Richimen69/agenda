// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USUARIOS
model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  password      String       @default("123456") // NUEVO: Contraseña encriptada
  whatsappPhone String
  role          Role         @default(USER) // NUEVO: Rol del usuario
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  moduleRoles   ModuleRole[]

  createdTickets         Ticket[]          @relation("CreatedTickets")
  assignedTickets        Ticket[]          @relation("AssignedTickets")
  eventsCreated          Event[]           @relation("EventCreator")
  eventsAttending        Event[]           @relation("EventAttendees")
  reminders              Reminder[]
  auditLogs              AuditLog[]
  comments               Comment[]
  subtasks               Subtask[]
  shortLinks             ShortLink[]
  createdProjects        Project[]         @relation("ProjectCreator")
  projectMemberships     ProjectMember[]
  assignedActions        ProjectAction[]   @relation("ActionOwner")
  kpiRecords             KpiRecord[]
  projectComments        ProjectComment[]
  areaId                 String?
  area                   Area?             @relation("UserArea", fields: [areaId], references: [id], onDelete: SetNull)
  advisorSessions        LiveSession[]     @relation("AdvisorSessions")
  technicianSessions     LiveSession[]     @relation("TechnicianSessions")
  createdSupportTickets  SupportTicket[]   @relation("CreatedSupportTickets")
  assignedSupportTickets SupportTicket[]   @relation("AssignedSupportTickets")
  supportComments        SupportComment[]  @relation("UserSupportComments")
  supportAuditLogs       SupportAuditLog[] @relation("UserSupportAudit")
}

// 2. TICKETS / PROYECTOS
model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      Status   @default(NUEVO) // Estado inicial cambiado
  priority    Priority @default(MEDIA)
  creatorId   String
  creator     User     @relation("CreatedTickets", fields: [creatorId], references: [id])

  assignees User[] @relation("AssignedTickets")

  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events          Event[]
  reminders       Reminder[]
  auditLogs       AuditLog[]
  comments        Comment[]
  subtasks        Subtask[]
  projectActionId String?        @unique
  projectAction   ProjectAction? @relation("TicketToAction", fields: [projectActionId], references: [id], onDelete: Cascade)
}

// 3. NUEVO: AGENDA COLABORATIVA
model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime // Fecha y hora del evento

  // Quién lo creó
  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])

  // Opcional: ¿Está vinculado a un proyecto/ticket?
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  // Invitados al evento (Relación implícita muchos-a-muchos de Prisma)
  attendees User[] @relation("EventAttendees")

  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 4. RECORDATORIOS (Nuestra Cola Universal para WhatsApp)
model Reminder {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId          String?
  ticket            Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventId           String?
  event             Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionId          String?
  action            ProjectAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime // Cuándo debe enviarse el WhatsApp
  messagePayload    String         @db.Text // El texto exacto a enviar
  status            ReminderStatus @default(PENDING)
  retryCount        Int            @default(0)
  errorLog          String?        @db.Text
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  supportTicketId   String?
  supportTicket     SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  whatsappMessageId String?        @unique // ID devuelto por Meta al enviar
  deliveryStatus    String? // 'sent', 'delivered', 'read', 'failed'
  isTemplate        Boolean        @default(false) // ¿Es plantilla pre-aprobada por Meta?
  templateName      String? // Nombre de la plantilla (ej: 'ticket_update')

  @@index([status, scheduledAt])
}

model Comment {
  id       String  @id @default(uuid())
  text     String  @db.Text
  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// 5. BITÁCORA
model AuditLog {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json
  createdAt DateTime @default(now())
}

model Subtask {
  id     String  @id @default(uuid())
  title  String
  isDone Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  projectActionId String?        @unique
  projectAction   ProjectAction? @relation("SubtaskToAction", fields: [projectActionId], references: [id], onDelete: Cascade)
}

model ShortLink {
  id          String @id @default(uuid()) // Ajustado a UUID por consistencia
  originalUrl String @db.Text
  shortCode   String @unique
  clicks      Int    @default(0)

  userId String // Ajustado a String para poder relacionarse con User.id
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shortCode])
}

model Project {
  id             String        @id @default(uuid())
  title          String
  description    String?       @db.Text
  status         ProjectStatus @default(NEW)
  targetDate     DateTime
  globalProgress Float         @default(0)
  health         ProjectHealth @default(GREEN)

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id])

  // Relations
  members         ProjectMember[]
  actions         ProjectAction[]
  reminders       Reminder[]
  projectComments ProjectComment[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  comments  Comment[]
  ratios    ProjectRatio[]
}

model ProjectMember {
  id        String     @id @default(uuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleType  MemberRole // OWNER, SUPPORT, OBSERVER
  areaId    String
  area      Area       @relation(fields: [areaId], references: [id])

  businessRole String?
  createdAt    DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectAction {
  id        String   @id @default(uuid())
  title     String
  weight    Float    @default(1.0)
  progress  Float    @default(0)
  startDate DateTime
  endDate   DateTime

  ownerId   String?
  owner     User?   @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Infinite Hierarchical Tree
  parentId String?
  parent   ProjectAction?  @relation("ActionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectAction[] @relation("ActionHierarchy")

  kpis      Kpi[]
  reminders Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket    Ticket?  @relation("TicketToAction")
  subtask   Subtask? @relation("SubtaskToAction")
}

model Kpi {
  id           String  @id @default(uuid())
  name         String
  unit         String
  target       Float
  type         KpiType
  currentValue Float   @default(0)

  actionId String
  action   ProjectAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  records  KpiRecord[]
}

model KpiRecord {
  id     String  @id @default(uuid())
  value  Float
  note   String? @db.Text
  kpiId  String
  kpi    Kpi     @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  userId String
  user   User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model ProjectComment {
  id        String  @id @default(uuid())
  text      String  @db.Text
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Area {
  id       String          @id @default(uuid())
  name     String          @unique
  parentId String?
  parent   Area?           @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Area[]          @relation("AreaHierarchy")
  members  ProjectMember[]
  users    User[]          @relation("UserArea")
}

// =========================================================
// MÓDULO DE TRANSMISIONES EN VIVO (TOYOTA LIVE)
// =========================================================

model LiveSession {
  id            String  @id @default(uuid())
  roomName      String
  customerName  String
  customerPhone String?
  vehicleModel  String?

  // RELACIÓN CON EL TIPO DE SERVICIO SELECCIONADO
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)

  currentStageId String?
  currentStage   ServiceStage? @relation("CurrentStage", fields: [currentStageId], references: [id], onDelete: SetNull)

  advisorId    String?
  advisor      User?           @relation("AdvisorSessions", fields: [advisorId], references: [id], onDelete: SetNull)
  technicianId String?
  technician   User?           @relation("TechnicianSessions", fields: [technicianId], references: [id], onDelete: SetNull)
  status       SessionStatus   @default(WAITING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  recordings   LiveRecording[]
}

model LiveRecording {
  id        String      @id @default(uuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fileUrl   String      @db.Text
  fileSize  BigInt?
  createdAt DateTime    @default(now())
}

model ServiceType {
  id          String   @id @default(uuid())
  name        String   @unique // Ej. 'Mantenimiento Express 60k', 'Diagnóstico Eléctrico'
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages   ServiceStage[] // Relación con sus etapas configuradas
  sessions LiveSession[] // Sesiones asociadas a este tipo de servicio
}

model ServiceStage {
  id    String @id @default(uuid())
  name  String // Ej. 'Recepción', 'Alineación', 'Lavado', 'Listo'
  order Int // Secuencia numérica (1, 2, 3...) de la etapa en este servicio

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  currentSessions LiveSession[] @relation("CurrentStage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceTypeId, order])
}

model Lead {
  id       Int      @id @default(autoincrement())
  date     DateTime @default(now())
  phone    String?
  fullName String

  department    Department    @default(NUEVOS)
  contactMethod ContactMethod @default(WHATSAPP)

  agent    String?
  interest String?

  status       LeadStatus    @default(NUEVO)
  contactState ContactState?

  needsRecovery  Boolean         @default(false) // Activa la alerta para la chica de recuperación
  recoveryStatus RecoveryStatus? // Estado exacto de la recuperación
  lostReason     String? // Ej. "Su número se encuentra fuera de servicio"

  firstContactTime Float?
  assignment       String?

  hasAppointment Boolean @default(false)
  showedUp       Boolean @default(false)
  hasQuote       Boolean @default(false)
  amount         Float?

  source            String // Ej. "CAMPAÑA PRIUS"
  lastContactSource String?
  isReturning       Boolean         @default(false)
  branch            Branch          @default(GUERRERO)
  captureView       CaptureViewType @default(ALL)
  // OPTIMIZACIÓN 3: Historial de comentarios relacional
  comments          LeadComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([source])
  @@index([status])
  @@index([needsRecovery])
  @@index([phone])
}

model LeadComment {
  id     String      @id @default(uuid())
  text   String      @db.Text
  type   CommentType @default(USER_NOTE)
  leadId Int
  lead   Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  author    String // Ej. "Asesor" o "Recuperación"
  createdAt DateTime @default(now())
}

model ProjectRatio {
  id   String @id @default(uuid())
  name String // Ej. "Costo por Contratación", "Costo por Prospecto"
  unit String // Ej. "MXN/ud", "USD/cl"

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  numeratorNames   String[]
  denominatorNames String[]

  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String              @id @default(uuid())
  folio       Int                 @default(autoincrement())
  title       String
  description String?             @db.Text
  status      SupportTicketStatus @default(ABIERTO)
  priority    Priority            @default(MEDIA)

  creatorId String
  creator   User   @relation("CreatedSupportTickets", fields: [creatorId], references: [id])

  assignedTechId String?
  assignedTech   User?   @relation("AssignedSupportTickets", fields: [assignedTechId], references: [id])

  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  whatsappThreadActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  SupportComment[]
  auditLogs SupportAuditLog[]
  reminders Reminder[]
  attachments SupportAttachment[]
}

model SupportAttachment {
  id               String          @id @default(uuid())
  fileUrl          String          @db.Text // La ruta donde se guardó (ej. AWS S3, Cloudinary o carpeta local)
  fileName         String          // Ej. "pantalla_azul.jpg"
  fileType         String          // Ej. "image/jpeg" o "application/pdf"
  
  supportTicketId  String?
  supportTicket    SupportTicket?  @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  
  supportCommentId String?
  supportComment   SupportComment? @relation(fields: [supportCommentId], references: [id], onDelete: Cascade)

  createdAt        DateTime        @default(now())
}

model SupportComment {
  id   String @id @default(uuid())
  text String @db.Text

  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("UserSupportComments", fields: [authorId], references: [id], onDelete: Cascade)

  // ==========================================
  // INTEGRACIÓN WHATSAPP WEBHOOK
  // ==========================================
  isFromWhatsApp    Boolean @default(false)
  whatsappMessageId String? @unique

  createdAt DateTime @default(now())
  attachments SupportAttachment[]
}

model SupportAuditLog {
  id              String        @id @default(uuid())
  supportTicketId String
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("UserSupportAudit", fields: [userId], references: [id], onDelete: SetNull)

  action  String // Ej: "STATUS_CHANGE", "ASSIGNED"
  details Json // Ej: { from: "ABIERTO", to: "EN_PROGRESO" }

  // Auditoría de tiempos para la gerencia
  timeElapsedSeconds Int? // Segundos transcurridos desde el último cambio

  createdAt DateTime @default(now())
}

enum SupportTicketStatus {
  ABIERTO
  EN_PROGRESO
  ESPERANDO_USUARIO
  RESUELTO
  CERRADO
}

enum CommentType {
  SYSTEM_CREATED
  SYSTEM_REACTIVATED
  SYSTEM_STATUS_CHANGE
  USER_NOTE
}

enum ModuleRole {
  LEADS_ADMIN
  LEADS_AUX
  LEADS_RESPONSABLE
  LIVE_ADMIN
}

enum Department {
  NUEVOS
  SEMINUEVOS
  SERVICIO
  OPERADOR
  REFACCIONES
  DIGITAL
}

enum Branch {
  GUERRERO
  CHILPANCINGO
  DIGITAL
}

enum ContactMethod {
  WHATSAPP
  LLAMADA
  FACEBOOK_MESSENGER
  INSTAGRAM
  FORMULARIO_WEB
}

enum LeadStatus {
  NUEVO
  ATENDIDO
  AGENDADO
  PERDIDO
}

enum RecoveryStatus {
  EN_SEGUIMIENTO
  NO_CONTACTABLE
  RECUPERADO_Y_ASIGNADO
  DESCARTADO
}

enum ContactState {
  R1_POR_CONTACTAR
  R2_CONTACTADO
  R3_ASIGNADO
}

enum SessionStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum Status {
  NUEVO
  EN_PROGRESO
  REVISION
  COMPLETADO
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum Role {
  ADMIN
  USER
}

enum CaptureViewType {
  ALL
  NS
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum ProjectStatus {
  NEW         @map("NUEVO")
  IN_PROGRESS @map("EN_PROGRESO")
  REVIEW      @map("REVISION")
  COMPLETED   @map("COMPLETADO")
}

enum ProjectHealth {
  GREEN  @map("VERDE")
  YELLOW @map("AMARILLO")
  RED    @map("ROJO")
}

enum MemberRole {
  OWNER    @map("OWNER")
  SUPPORT  @map("SOPORTE")
  OBSERVER @map("OBSERVER")
}

enum KpiType {
  ACCUMULABLE @map("ACUMULABLE")
  STATUS      @map("ESTADO")
  FINANCIAL   @map("FINANCIERO")
  MILESTONE   @map("HITO")
}
